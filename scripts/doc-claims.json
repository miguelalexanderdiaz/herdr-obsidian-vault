[
 {
  "id": "per-folder",
  "doc": "docs/configuration.html",
  "docText": "PER_FOLDER mods/vault/main.js 2000",
  "code": "mods/vault/main.js",
  "pattern": "\\bPER_FOLDER\\s*=\\s*2000\\b"
 },
 {
  "id": "per-folder-usage",
  "doc": "docs/usage.html",
